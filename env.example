# Public, non-secret build-time configuration. Never put secrets in VITE_ variables.

# Canonical origin, e.g. https://your-domain.example  (leave empty to omit canonical/og:url/sitemap)
VITE_SITE_URL=

# Contact: set at least one, otherwise the Contact page says contact details are not configured yet.
VITE_CONTACT_EMAIL=
VITE_CONTACT_URL=

# Advertising (disabled by default). Requires consent; no ad script loads otherwise.
VITE_ADS_ENABLED=false
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Optional analytics (Plausible-compatible). Disabled when empty. Requires consent.
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
